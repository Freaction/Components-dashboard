{
  "name": "components-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "dev.bat",
    "dev:start": "concurrently -n \"RUST,WEB\" -c \"magenta,cyan\" \"cargo run --release --manifest-path apps/api-rust/Cargo.toml\" \"npm run dev --workspace=web\"",
    "clean": "rimraf node_modules apps/web/node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.0"
  }
}
